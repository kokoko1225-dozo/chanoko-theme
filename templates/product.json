{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "cnk_summary": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'cnk-pdp-summary', product: product %}"
          }
        },
        "cnk_desc": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'cnk-pdp-desc', product: product %}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "disabled": true
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "disabled": true,
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "cnk_action": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'cnk-pdp-action', product: product %}"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "cnk_summary",
        "cnk_desc",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "cnk_action"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": true,
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "details": {
      "type": "cnk-product-details",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "水でも溶けますか？",
            "answer": "<p>細かい粉末なので、水でも振れば混ざります。素材によっては底に少し沈むので、飲む前にひと振りしてください。</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "保存方法は？",
            "answer": "<p>直射日光と高温多湿を避けて保存してください。パウチは開封後しっかり封をして、早めにお召し上がりください。</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "いつ届きますか？",
            "answer": "<p>現在は予約・入荷のお知らせを受付中です。販売開始の際にメールでお知らせします。販売開始後は、ご注文から3〜5営業日以内に発送します。</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "送料はいくらですか？",
            "answer": "<p>全国一律450円(税込)です。</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "返品はできますか？",
            "answer": "<p>食品のため、お客様のご都合による返品はお受けしていません。破損や、ご注文と違う商品が届いた場合は、到着後7日以内にご連絡ください。詳しくは<a href=\"/policies/legal-notice\">特定商取引法に基づく表記</a>をご覧ください。</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "妊娠中の方や子どもでも飲めますか？",
            "answer": "<p>カフェインを含む商品(抹茶・ほうじ茶)は量に気をつけてください。体質や体調に不安がある場合は、医師にご相談ください。</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ],
      "settings": {
        "show_taste": true,
        "trial": "trial-set",
        "trial_handles": "matcha,hojicha,roasted-burdock,ube,yomogi,butterfly-pea"
      }
    }
  },
  "order": [
    "main",
    "details"
  ]
}