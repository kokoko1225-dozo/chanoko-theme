{%- comment -%}茶の子:置き換える。強さ2(白地、静か)。{%- endcomment -%}
<section class="cnk-section cnk-swap">
  <div class="page-width">
    <h2 class="cnk-h2">{{ section.settings.heading }}</h2>
    <ul class="cnk-swap__list" role="list">
      {%- for block in section.blocks -%}
        {%- capture d -%}{% render 'cnk-data', handle: block.settings.product.handle %}{%- endcapture -%}
        {%- assign d = d | split: '|' -%}
        <li class="cnk-swap__item" {{ block.shopify_attributes }}>
          <p class="cnk-swap__from">{{ block.settings.from }}</p>
          <span class="cnk-swap__arrow" aria-hidden="true">↓</span>
          {%- if block.settings.product -%}
            <a class="cnk-swap__to" href="{{ block.settings.product.url }}" style="--cnk-c: {{ d[0] }};">
              <span class="cnk-dot" aria-hidden="true"></span>{{ block.settings.to }}
            </a>
          {%- else -%}
            <p class="cnk-swap__to">{{ block.settings.to }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.price_note != blank -%}<p class="cnk-swap__note">{{ section.settings.price_note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "茶の子:置き換える",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "その一杯を、置き換える。" },
    { "type": "text", "id": "price_note", "label": "価格の一行", "default": "カフェのラテは1杯約500円。茶の子なら、1杯約107円から。" }
  ],
  "blocks": [
    {
      "type": "swap",
      "name": "置き換え",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "from", "label": "今の一杯", "default": "コーヒーの2杯目を" },
        { "type": "text", "id": "to", "label": "茶の子の一杯", "default": "抹茶に" },
        { "type": "product", "id": "product", "label": "商品" }
      ]
    }
  ],
  "presets": [{ "name": "茶の子:置き換える" }]
}
{% endschema %}
