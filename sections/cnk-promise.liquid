{%- comment -%}茶の子:約束。強さ1。白地に3つ。{%- endcomment -%}
<section class="cnk-section cnk-promise">
  <div class="page-width">
    <h2 class="cnk-h2">{{ section.settings.heading }}</h2>
    <ul class="cnk-promise__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <p class="cnk-promise__title">{{ block.settings.title }}</p>
          <p class="cnk-promise__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.link_label != blank -%}<p class="cnk-more"><a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "茶の子:約束",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "茶の子の約束" },
    { "type": "text", "id": "link_label", "label": "リンクの文言", "default": "茶の子について" },
    { "type": "url", "id": "link", "label": "リンク" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "約束",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "見出し" },
        { "type": "textarea", "id": "text", "label": "説明" }
      ]
    }
  ],
  "presets": [{ "name": "茶の子:約束" }]
}
{% endschema %}
