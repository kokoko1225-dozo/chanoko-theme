{%- comment -%}茶の子:作り方。強さ3。{%- endcomment -%}
<section class="cnk-section cnk-howto cnk-bg-paper">
  <div class="page-width">
    <div class="cnk-section__head">
      <h2 class="cnk-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cnk-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="cnk-howto__body">
      {%- if section.settings.video != blank -%}
        <div class="cnk-howto__video">
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '900x' }}
        </div>
      {%- endif -%}
      <ol class="cnk-steps" role="list">
        {%- for block in section.blocks -%}
          <li class="cnk-step" {{ block.shopify_attributes }}>
            <span class="cnk-step__num">{{ forloop.index | prepend: '0' }}</span>
            <p class="cnk-step__title">{{ block.settings.title }}</p>
            <p class="cnk-step__text">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if section.settings.note != blank -%}<p class="cnk-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "茶の子:作り方",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "10秒で、一杯。" },
    { "type": "textarea", "id": "text", "label": "説明" },
    { "type": "video", "id": "video", "label": "短い動画" },
    { "type": "textarea", "id": "note", "label": "注記", "default": "温かく飲む時は、カップで少量のお湯に溶いてから注ぎ足してください。熱いお湯をシェイカーで振るのは避けてください。" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "手順",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "手順", "default": "入れる" },
        { "type": "text", "id": "text", "label": "説明", "default": "シェイカーにスティック1本" }
      ]
    }
  ],
  "presets": [{ "name": "茶の子:作り方" }]
}
{% endschema %}
