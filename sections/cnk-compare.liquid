{%- comment -%}茶の子:10種の比較表。中身は cnk-data から作る。{%- endcomment -%}
{%- assign c = section.settings.collection -%}
<section class="cnk-section cnk-compare">
  <div class="page-width">
    <div class="cnk-section__head">
      <h2 class="cnk-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cnk-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if c != blank -%}
      <div class="cnk-compare__scroll" tabindex="0" aria-label="比較表(横にスクロールできます)">
        <table class="cnk-compare__table">
          <thead>
            <tr><th scope="col">素材</th><th scope="col">カフェイン</th><th scope="col">味</th><th scope="col">近いもの</th><th scope="col">1杯あたり</th></tr>
          </thead>
          <tbody>
            {%- for product in c.products -%}
              {%- unless product.handle == 'trial-set' -%}
                {%- capture d -%}{% render 'cnk-data', handle: product.handle %}{%- endcapture -%}
                {%- assign d = d | split: '|' -%}
                <tr style="--cnk-c: {{ d[0] }};">
                  <th scope="row"><a href="{{ product.url }}"><span class="cnk-dot" aria-hidden="true"></span>{{ product.title }}</a></th>
                  <td>{{ d[3] }}</td>
                  <td>{{ d[2] }}</td>
                  <td>{{ d[7] }}</td>
                  <td>{% render 'cnk-per-cup', product: product, mode: 'min' %}</td>
                </tr>
              {%- endunless -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "茶の子:比較表",
  "settings": [
    { "type": "collection", "id": "collection", "label": "コレクション" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "10種を比べる" },
    { "type": "textarea", "id": "text", "label": "説明" }
  ],
  "presets": [{ "name": "茶の子:比較表" }]
}
{% endschema %}
